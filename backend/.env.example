# Copy to .env and edit. Never commit .env.
ENVIRONMENT=development            # development | testing | production
DATABASE_URL=sqlite:///./fraudshield.db
# PostgreSQL example: postgresql+psycopg://user:password@localhost:5432/fraudshield

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required when ENVIRONMENT=production. In development a random key is generated per start.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOGIN_RATE_WINDOW_MINUTES=15
LOGIN_RATE_ACCOUNT_LIMIT=10
LOGIN_RATE_SOURCE_LIMIT=40
HSTS_MAX_AGE_SECONDS=31536000
AUTO_CREATE_TABLES=true            # set false in production; run Alembic migrations
MAX_REQUEST_BYTES=1048576

# Comma-separated list of allowed frontend origins (Vite default shown)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Folder containing the three .pkl artifacts (default: <repo root>/models)
# MODEL_DIR=../models

# First administrator, created at startup only if the email does not exist yet
INITIAL_ADMIN_EMAIL=admin@fraudshield.local
# Set this to a unique secret before starting the backend to bootstrap the initial admin.
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=System Administrator

# If true, anyone can self-register (always as least-privileged BI Analyst)
ALLOW_PUBLIC_REGISTRATION=false
